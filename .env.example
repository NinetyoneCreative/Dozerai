# Analytics - set one (or both) to go live. Until set, nothing loads but
# track() still console-logs in dev. See components/Analytics.tsx.
NEXT_PUBLIC_GA4_ID=            # TODO: e.g. G-XXXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=  # TODO: e.g. dozer.ai

# HubSpot Meetings scheduler shown on /demo after a successful form submit.
# The "Dozer AI Intro call" meeting link. If unset, /demo shows a thank-you
# message instead of the scheduler, so the page never breaks.
NEXT_PUBLIC_HUBSPOT_MEETINGS_URL=   # e.g. https://meetings-na2.hubspot.com/mike-valdez/dozer-intro-call
